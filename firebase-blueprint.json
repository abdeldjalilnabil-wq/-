{
  "entities": {
    "PlatformSettings": {
      "title": "PlatformSettings",
      "description": "Global platform branding, designer attribution, owner contact, feature flags, language, payment accounts, and usage pricing controlled by the app owner.",
      "type": "object",
      "properties": {
        "appName": {
          "type": "string",
          "description": "Custom application brand name.",
          "minLength": 2,
          "maxLength": 60
        },
        "appTagline": {
          "type": "string",
          "description": "Short subtitle describing the app.",
          "minLength": 0,
          "maxLength": 140
        },
        "ownerName": {
          "type": "string",
          "description": "Application owner display name.",
          "minLength": 1,
          "maxLength": 80
        },
        "ownerPhone": {
          "type": "string",
          "description": "Application owner personal phone number.",
          "minLength": 0,
          "maxLength": 25
        },
        "designerName": {
          "type": "string",
          "description": "Application designer/creator attribution name.",
          "minLength": 1,
          "maxLength": 80
        },
        "designerLocation": {
          "type": "string",
          "description": "Designer city/country attribution.",
          "minLength": 0,
          "maxLength": 80
        },
        "designerInstagram": {
          "type": "string",
          "description": "Designer Instagram handle.",
          "minLength": 0,
          "maxLength": 60
        },
        "pricingEnabled": {
          "type": "boolean",
          "description": "Whether barbershops require a paid subscription to use the platform."
        },
        "usagePrice": {
          "type": "number",
          "description": "Usage subscription price set by the platform owner."
        },
        "currency": {
          "type": "string",
          "description": "Currency label (e.g. دج, USD, EUR).",
          "minLength": 1,
          "maxLength": 20
        },
        "billingCycle": {
          "type": "string",
          "enum": ["monthly", "yearly", "per_booking"],
          "description": "Billing cadence for using the application."
        },
        "paymentInstructions": {
          "type": "string",
          "description": "Owner contact and payment instructions for activating subscriptions.",
          "minLength": 0,
          "maxLength": 300
        },
        "autoApproveCardPayments": {
          "type": "boolean",
          "description": "Automatically activate subscription on validated electronic card checkout."
        },
        "baridiMobRip": {
          "type": "string",
          "description": "Owner BaridiMob RIP for Algerian electronic payments.",
          "minLength": 0,
          "maxLength": 40
        },
        "ccpAccount": {
          "type": "string",
          "description": "Owner Algérie Poste CCP account number.",
          "minLength": 0,
          "maxLength": 40
        },
        "chargilyPayUrl": {
          "type": "string",
          "description": "Optional external Chargily Pay (Edahabia/CIB) checkout URL.",
          "minLength": 0,
          "maxLength": 240
        },
        "stripeCheckoutUrl": {
          "type": "string",
          "description": "Optional external international card checkout URL.",
          "minLength": 0,
          "maxLength": 240
        },
        "paypalLink": {
          "type": "string",
          "description": "Owner PayPal.me link or PayPal email.",
          "minLength": 0,
          "maxLength": 140
        },
        "wiseIban": {
          "type": "string",
          "description": "Owner Wise / Paysera / SEPA IBAN or account.",
          "minLength": 0,
          "maxLength": 100
        },
        "heroTitle": {
          "type": "string",
          "description": "Landing page main headline controlled by platform owner.",
          "minLength": 0,
          "maxLength": 140
        },
        "heroSubtitle": {
          "type": "string",
          "description": "Landing page subtitle/description controlled by platform owner.",
          "minLength": 0,
          "maxLength": 300
        },
        "footerNote": {
          "type": "string",
          "description": "Optional custom footer note controlled by platform owner.",
          "minLength": 0,
          "maxLength": 140
        },
        "defaultTheme": {
          "type": "string",
          "enum": ["gold", "emerald", "blue", "burgundy", "dark"],
          "description": "Default color theme applied for new users."
        },
        "defaultLanguage": {
          "type": "string",
          "description": "Default ISO language code for the application.",
          "minLength": 2,
          "maxLength": 10
        },
        "allowVoiceCalls": {
          "type": "boolean"
        },
        "allowWhatsApp": {
          "type": "boolean"
        },
        "allowInAppMessages": {
          "type": "boolean"
        },
        "allowDeferTurn": {
          "type": "boolean"
        },
        "allowComplaints": {
          "type": "boolean"
        },
        "allowBarberSocials": {
          "type": "boolean"
        },
        "allowLocationFilter": {
          "type": "boolean"
        },
        "allowNewBarberRegistration": {
          "type": "boolean"
        },
        "allowAppDownload": {
          "type": "boolean"
        },
        "androidDownloadUrl": {
          "type": "string",
          "description": "Optional direct Android APK or Google Play link configured by owner.",
          "minLength": 0,
          "maxLength": 240
        },
        "iosDownloadUrl": {
          "type": "string",
          "description": "Optional direct iOS App Store or TestFlight link configured by owner.",
          "minLength": 0,
          "maxLength": 240
        },
        "desktopDownloadUrl": {
          "type": "string",
          "description": "Optional direct Windows/macOS desktop installer link configured by owner.",
          "minLength": 0,
          "maxLength": 240
        },
        "maintenanceMode": {
          "type": "boolean"
        },
        "maintenanceMessage": {
          "type": "string",
          "minLength": 0,
          "maxLength": 240
        },
        "serviceHaircutLabel": {
          "type": "string",
          "minLength": 0,
          "maxLength": 50
        },
        "serviceProteinLabel": {
          "type": "string",
          "minLength": 0,
          "maxLength": 50
        },
        "serviceBlowdryLabel": {
          "type": "string",
          "minLength": 0,
          "maxLength": 50
        },
        "serviceAllLabel": {
          "type": "string",
          "minLength": 0,
          "maxLength": 60
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "appName",
        "appTagline",
        "ownerName",
        "designerName",
        "pricingEnabled",
        "usagePrice",
        "currency",
        "billingCycle",
        "paymentInstructions",
        "updatedAt"
      ]
    },
